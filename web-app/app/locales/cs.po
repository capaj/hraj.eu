#: src/pages/TOSPage.tsx:406
msgid "<0>EU Users:</0> Nothing in these terms affects your statutory rights as a consumer under applicable EU law."
msgstr "<0>Uživatelé z EU:</0> Tyto podmínky neomezují vaše zákonná práva spotřebitele podle platných právních předpisů EU."

#: src/pages/TOSPage.tsx:297
msgid "<0>Important:</0> Sports activities involve inherent risks. Please ensure you have appropriate insurance coverage and assess your fitness level before participating."
msgstr "<0>Důležité:</0> Sportovní aktivity s sebou nesou rizika. Před účastí si zajistěte odpovídající pojištění a zvažte svou fyzickou kondici."

#: src/pages/TOSPage.tsx:50
msgid "<0>Important:</0> These terms constitute a legally binding agreement between you and hraj.eu. Please read them carefully."
msgstr "<0>Důležité:</0> Tyto podmínky představují právně závaznou dohodu mezi vámi a hraj.eu. Přečtěte si je prosím pečlivě."

#: src/pages/PrivacyPage.tsx:111
msgid "<0>Improve Platform:</0> Analyze usage patterns to enhance features and user experience"
msgstr "<0>Zlepšování platformy:</0> Analýza způsobu používání za účelem zlepšení funkcí a uživatelského prostředí"

#: src/pages/PrivacyPage.tsx:118
msgid "<0>Legal Compliance:</0> Comply with applicable laws and respond to legal requests"
msgstr "<0>Plnění právních povinností:</0> Dodržování platných zákonů a vyřizování zákonných žádostí"

#: src/pages/TOSPage.tsx:244
msgid "<0>Note:</0> Consistently low karma scores may result in restricted access to certain platform features."
msgstr "<0>Poznámka:</0> Dlouhodobě nízká karma může vést k omezení přístupu k některým funkcím platformy."

#: src/pages/PrivacyPage.tsx:89
msgid "<0>Provide Services:</0> Create and manage your account, facilitate event creation and participation, process payments"
msgstr "<0>Poskytování služeb:</0> Vytváření a správa vašeho účtu, zajištění tvorby událostí a účasti na nich, zpracování plateb"

#: src/pages/PrivacyPage.tsx:293
msgid "<0>Response Time:</0> We will respond to your request within 30 days"
msgstr "<0>Doba odpovědi:</0> Na vaši žádost odpovíme do 30 dnů"

#: src/pages/PrivacyPage.tsx:104
msgid "<0>Safety & Security:</0> Verify user identity, prevent fraud, and maintain community standards"
msgstr "<0>Bezpečnost:</0> Ověřování totožnosti uživatelů, předcházení podvodům a dodržování pravidel komunity"

#: src/pages/TOSPage.tsx:457
msgid "<0>Tip:</0> We recommend reviewing these terms periodically to stay informed of any updates."
msgstr "<0>Tip:</0> Doporučujeme tyto podmínky pravidelně kontrolovat, abyste měli přehled o případných změnách."

#: src/pages/PrivacyPage.tsx:167
msgid "<0>We never sell your personal information</0> to third parties for marketing purposes."
