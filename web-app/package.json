{
  "name": "hraj.eu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm lingui:extract && pnpm lingui:compile && vite build",
    "ci:build": "pnpm run build && pnpm run migrate",
    "start": "vite start",
    "test": "tsx --test tests/*.test.mjs",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "screenshot": "node screenshots/capture-page.mjs",
    "bump": "ncu -u -c 2d",
    "migrate": "drizzle-kit migrate",
    "generate": "drizzle-kit generate",
    "deploy": "pnpm run ci:build && wrangler deploy",
    "wrdeploy": "pnpm run deploy",
    "postinstall": "pnpm run cf-typegen",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "lingui:extract": "lingui extract --clean",
    "lingui:compile": "lingui compile --strict"
  },
  "dependencies": {
    "@daveyplate/better-auth-tanstack": "^1.3.6",
    "@daveyplate/better-auth-ui": "^3.4.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@hookform/resolvers": "^7.0.2",
    "@libsql/client": "^0.18.0",
    "@lingui/core": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "@lingui/vite-plugin": "^6.12.0",
    "@paralleldrive/cuid2": "2.2.2",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/leaflet": "^1.9.22",
    "better-auth": "^1.7.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "input-otp": "^1.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.68.0",
    "lz-ts": "^1.1.2",
    "offline-geocode-city": "^1.0.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grab": "^0.2.0",
    "react-hook-form": "^7.91.0",
    "react-share-kit": "^2.0.0",
    "resend": "^6.37.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "workers-og": "^0.0.27",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@electric-sql/pglite": "^0.5.15",
    "@lingui/babel-plugin-lingui-macro": "^6.12.0",
    "@lingui/cli": "^6.12.0",
    "@lingui/conf": "^6.12.0",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "nitropack": "^2.13.6",
    "rollup": "^4.67.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.157.0"
  }
}
